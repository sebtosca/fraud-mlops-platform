# Copy to .env and adjust. Never commit .env.
# Hostnames match the Compose network aliases, which match the future k8s Service names.

ENV=local

# Postgres (POSTGRES_* are read by the Compose stack; keep DATABASE_URL in sync with them)
POSTGRES_USER=fraud
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://fraud:change-me@postgres:5432/fraud_local

# Kafka
KAFKA_BOOTSTRAP=fraud-kafka-kafka-bootstrap:9092
TOPIC_PREFIX=local

# Object store (SeaweedFS S3 API)
S3_ENDPOINT_URL=http://s3:8333
AWS_ACCESS_KEY_ID=fraud
AWS_SECRET_ACCESS_KEY=change-me
LAKE_BUCKET=lake

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_NAME=fraud-lgbm

# HMAC key for card_hash; generate with: openssl rand -hex 32
CARD_HASH_KEY=change-me

# Decision policy and rollout
EXPLORATION_RATE=0.02
CANARY_PCT=10

# Simulated clock: sim seconds per wall second (1 sim day ≈ 30 s)
SPEEDUP=2880

# Case-summary LLM (vLLM, OpenAI-compatible API)
LLM_BASE_URL=http://vllm:8000/v1

#region
REGION=us-east-1
